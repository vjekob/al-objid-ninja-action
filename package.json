{
  "name": "al-objid-ninja-action",
  "version": "1.0.0",
  "description": "GitHub Action for AL Object ID Ninja CI/CD integration",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && ncc build src/main.ts -o dist --minify",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "build:cli": "ncc build src/cli.ts -o dist-cli --minify && node scripts/prepare-cli.js",
    "pack:cli": "npm run build:cli && npm pack ./cli-package"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/glob": "^0.5.0",
    "comment-json": "^4.6.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.0",
    "@vercel/ncc": "^0.38.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.0"
  },
  "license": "SEE LICENSE IN LICENSE"
}
